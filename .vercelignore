# Vercel 번들에서 뺄 것 (VERCEL.md 1장).
#
# ★ 이 파일이 있으면 Vercel 은 `.gitignore` 대신 **이 파일만** 본다.
#   그래서 가상환경·비밀파일도 여기서 다시 막아야 한다.

# ── 비밀 ────────────────────────────────────────────────────────
# 환경변수는 Vercel 대시보드에서 주입한다. .env 를 올리면 로컬 DB 설정이
# 운영을 덮어써 접속이 통째로 어긋난다.
.env
.env.*
!.env.example
*.pem
*.key

# ── 가상환경·캐시 (번들 용량의 대부분) ──────────────────────────
backend/.venv/
.venv/
venv/
__pycache__/
*.pyc
backend/.fastembed-cache/
# backend/staticfiles/ 는 빈 디렉터리째 번들에 넣는다 (WhiteNoise 가짜 경고 방지 · .gitkeep 참조)
backend/media/

# ── 프런트 빌드 도구 (산출물 app.css 만 있으면 된다) ────────────
backend/node_modules/
node_modules/

# ── v1.0 코드 — v2.0 배포에 필요 없다 ───────────────────────────
python-stock-backend/
frontend/
database/
docker/
docker-compose.yml

# ── 문서·캡처·스크립트 ──────────────────────────────────────────
docs/
captures/
scripts/
.github/
*.md
!VERCEL.md

# ── 기타 ────────────────────────────────────────────────────────
.git/
.idea/
.vscode/
tmp/
temp/
*.log
*.zip

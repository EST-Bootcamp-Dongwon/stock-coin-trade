# Vercel 번들에서 뺄 것 (VERCEL.md 1장).
#
# ★ 이 파일이 있으면 Vercel 은 `.gitignore` 대신 **이 파일만** 본다.
#   그래서 가상환경·비밀파일도 여기서 다시 막아야 한다.

# ── 비밀 ────────────────────────────────────────────────────────
# 환경변수는 Vercel 대시보드에서 주입한다. .env 를 올리면 로컬 DB 설정이
# 운영을 덮어써 접속이 통째로 어긋난다.
.env
.env.*
!.env.example
*.pem
*.key
# ★ Streamlit 시크릿은 위 `.env*` 패턴이 **못 막는다** (`.gitignore` 와 같은 이유).
#   문서화된 배포 경로가 `vercel --prod`(로컬 디렉터리 업로드)이고 이 파일이 있으면
#   Vercel 은 `.gitignore` 를 보지 않으므로, gitignore 된 로컬 `secrets.toml` 도
#   여기서 다시 막아야 번들에 올라가지 않는다.
.streamlit/

# ── 가상환경·캐시 (번들 용량의 대부분) ──────────────────────────
backend/.venv/
.venv/
venv/
__pycache__/
*.pyc
backend/.fastembed-cache/
# backend/staticfiles/ 는 빈 디렉터리째 번들에 넣는다 (WhiteNoise 가짜 경고 방지 · .gitkeep 참조)
backend/media/

# ── 프런트 빌드 도구 (산출물 app.css 만 있으면 된다) ────────────
backend/node_modules/
node_modules/

# ── v1.0 코드 — v2.0 배포에 필요 없다 ───────────────────────────
python-stock-backend/
frontend/
database/
docker/
docker-compose.yml

# ── 문서·캡처·스크립트 ──────────────────────────────────────────
docs/
captures/
scripts/
.github/
*.md
!VERCEL.md

# ── 기타 ────────────────────────────────────────────────────────
.git/
.idea/
.vscode/
tmp/
temp/
*.log
*.zip

# ── v3.0 (Streamlit) — Vercel 번들에 필요 없다 ──────────────────
# 🔴 **앞의 슬래시가 핵심이다.** 없으면 `requirements.txt` 가 모든 깊이에 일치해
#    방금 옮긴 `api/requirements.txt` 까지 함께 빠진다 — Vercel 을 되살리는 날
#    의존성 0개로 빌드가 깨지고 원인이 이 한 줄이라 아무도 못 찾는다.
#    (실측: 패턴 `requirements.txt` → 루트와 `api/requirements.txt` 둘 다 제외.
#           패턴 `/requirements.txt` → 루트만 제외)
/requirements.txt
streamlit_app.py
# ⚠️ **렌더러 B(섹터 화면)를 쓰는 날 아래 둘을 푼다** — Django 가 `sector/`·`dashboard/`
#   를 import 해야 한다(ADR-SC-0010 ②). 그때 `vercel.json` 의 `includeFiles` 도
#   `backend/**` 에서 함께 넓힌다. 지금은 v2.0 화면이 import 하지 않으므로 빼는 게 맞다.
# 🔒 `batch/` 는 **풀지 않는다** — 수집·집계는 로컬이고, 번들에 두면 돌릴 수 있어 보인다.
sector/
batch/
dashboard/

# ── 🔒 KRX 원천 데이터 ──────────────────────────────────────────
# `vercel --prod` 는 로컬 디렉터리를 올리며 `.gitignore` 를 보지 않는다. 즉 gitignore
# 된 원천이 번들로 새어 나갈 수 있다 — 약관 제11조②. `.gitignore` 와 같은 패턴을 둔다.
/data/
*.parquet
*.feather
/probe*.json
/krx_*.json
/response*.json
*.raw.json

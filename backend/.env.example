# backend/.env 로 복사해 실제 값을 채운다. .env 는 커밋하지 않는다.
# 저장소 루트의 .env(v1.0 MariaDB 용)와 분리한다 — 같은 파일을 공유하면 서로 덮어쓴다.

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── 로컬 개발 DB ────────────────────────────────────────────────
# docker compose --profile v2 up -d postgres  로 띄운다 (pgvector/pgvector:pg16)
POSTGRES_DB=stockcoin
POSTGRES_USER=stockcoin
POSTGRES_PASSWORD=stockcoin-dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# 서버리스는 0(매 요청 새 연결), 상시 기동 서버는 60 정도가 유리하다
DJANGO_CONN_MAX_AGE=0

# 로그 상세도. DEBUG 로 올리면 잡의 진행 로그가 한 줄씩 콘솔에 찍힌다.
DJANGO_LOG_LEVEL=INFO

# ── 내부 잡 엔드포인트 (F-20 3.1) ───────────────────────────────
# ★★ pg_cron 이 /internal/jobs/* 를 부를 때 쓰는 비밀값이다.
#    **비어 있으면 /internal/* 이 전부 404 로 막힌다** (fail closed).
#    운영에서는 같은 값을 Supabase Vault 에도 넣는다 — cron 잡이 거기서 읽는다
#    (backend/sql/pg_cron_jobs.sql 참조).
#    생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_JOB_TOKEN=

# ── 운영(Supabase) 예시 ─────────────────────────────────────────
# POSTGRES_HOST=db.<project-ref>.supabase.co
# POSTGRES_USER=postgres
# POSTGRES_SSLMODE=require

# ── 외부 브로커 자격증명 ────────────────────────────────────────
# ★ 앱키·시크릿은 **환경변수에만** 둔다. DB 에 넣지 않는다.
#   DB(market.ExternalToken)에 저장하는 것은 발급된 액세스 토큰뿐이고 24시간 후 만료된다.
#   발급 절차 → docs/v2-design/api/version2.0/api_발급_가이드.md

# 한국투자증권 KIS Developers (모의투자)
#
# ★★ **대회 모드의 실호가가 여기서 옵니다.** 비어 있으면 호가를 채울 수 없고,
#    대회 주문은 체결되지 않고 접수(ACCEPTED) 상태로 쌓입니다.
#    **거부되지는 않습니다** — 우리 쪽 장애로 참가자가 기회를 잃으면 안 됩니다 (F-16 3.4).
#    연습 모드는 KIS 없이도 동작합니다 (네이버 → 시뮬레이션).
#
#    발급 절차 → docs/v2-design/api/version2.0/api_발급_가이드.md 2장
#    연결 확인 → python manage.py kis_probe
KIS_MODE=mock                 # mock | real — 모의/실전은 앱키가 서로 다릅니다
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=               # 계좌번호 앞 8자리 (시세 조회에는 쓰지 않습니다)
KIS_ACCOUNT_PRODUCT_CODE=01   # 뒤 2자리

# 초당 호출 한도. **비워 두면 모의 2건 · 실전 15건**으로 봅니다.
#
# ★ 공개 자료가 "모의 초당 5건 / 2건 / 1건" 으로 엇갈립니다 (2026-08-13 확인 · 변경노트 E-43).
#   실계정으로 실측하기 전까지 **낮게 잡습니다** — 낮으면 폴링이 느려질 뿐이지만
#   높으면 EGW00201(유량 초과)이 연발해 대회 체결이 멈춥니다.
#   실측한 값이 있으면 여기에 적으십시오.
KIS_RATE_LIMIT=

# KB증권 Open API
KB_APP_KEY=
KB_APP_SECRET=

# Alpaca Paper Trading (미국 주식 모의투자)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── KRX 데이터포털 (pykrx — 종목 마스터·영업일) ────────────────
# ★★ 2026-08-13 확인 — data.krx.co.kr 이 **로그인을 요구하도록 바뀌었다.**
#    자격증명 없이 호출하면 모든 요청이 LOGOUT(HTTP 400)으로 돌아오고,
#    pykrx 는 그것을 엉뚱한 AttributeError 로 바꿔 던진다.
#      → sync_stock_master · sync_trading_calendar 가 동작하지 않는다.
#    https://data.krx.co.kr 무료 회원가입 후 아래를 채운다.
#
#    ★ 변수명 주의 — pykrx 가 읽는 이름은 KRX_PASSWORD 가 아니라 **KRX_PW** 다.
#    ★ 저장소 루트의 .env 에 넣으면 Django 가 읽지 않는다. 이 파일이어야 한다.
KRX_ID=
KRX_PW=

# ── 임베딩 (fastembed) ─────────────────────────────────────────
# 모델 캐시 위치. 비우면 backend/.fastembed-cache/ 를 쓴다 (.gitignore 대상).
# 첫 backfill_embeddings 실행 때 약 220MB 를 내려받는다.
FASTEMBED_CACHE_DIR=

# ── AI ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

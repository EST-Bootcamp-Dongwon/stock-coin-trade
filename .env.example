# ─────────────────────────────────────────────────────────────────
# stock-coin-trade — 환경변수 예시
#
# 🔒 이 파일에는 **키 이름만** 적는다. 실제 값은 `.env` 에만 넣고 커밋하지 않는다.
#    .gitignore 가 `.env*` 를 막고 `!.env.example` 로 이 파일만 풀어 준다.
#
# ⚠️ **.env 가 둘이다. 섞으면 조용히 무시된다.**
#    ┌──────────────────┬─────────────────────────────────────────┐
#    │ 루트 `.env`      │ v3.0 Streamlit·배치가 읽는다 (이 파일)    │
#    │ `backend/.env`   │ v2.0 Django 가 읽는 **유일한** 파일       │
#    └──────────────────┴─────────────────────────────────────────┘
#    Django 키를 루트 `.env` 에 넣으면 에러 없이 그냥 안 읽힌다.
#
# 배포(Streamlit Community Cloud)에서는 `.env` 대신 앱 설정의 Secrets 에 넣는다.
# 로컬 `.streamlit/secrets.toml` 도 커밋 금지다 (.gitignore 에 별도 규칙).
# ─────────────────────────────────────────────────────────────────

# ── ★ KRX Open API — 주 데이터 경로 ──────────────────────────────
# data-dbg.krx.co.kr/svc/apis/ · 요청 헤더 `AUTH_KEY`
# 인증키 발급 + **개별 API 이용신청**이 따로 필요하다
# (ETF 일별매매정보 · 유가증권/코스닥 일별매매정보 · 지수).
# 키당 일 10,000회 · 유효 1년(자동연장 없음).
# 🔴 `pykrx` 를 쓰지 않는다 — KRX FAQ 가 이름을 지목해 IP 차단을 경고한다.
KRX_API_KEY=
# KRX 홈페이지 로그인 계정 (Open API 신청·조회용. 호출에는 쓰지 않는다)
KRX_ID=
KRX_PW=

# ── ★ KIS 한국투자증권 — 준실시간 시세 ───────────────────────────
# 조회 전용이라 실주문 위험이 없고 유량이 모의투자의 7.5배다 → 실전 키를 쓴다.
#
# ⚠️ KIS_MODE 는 파일 전체에서 **한 번만** 정의한다. 같은 키를 두 번 쓰면
#   dotenv 가 나중 값으로 덮어써서 의도와 다른 도메인에 붙는다.
#   - real → 실전투자 도메인   - mock → 모의투자 도메인 (앱키가 서로 다르다)
KIS_MODE=real
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01

# ── ★ Hugging Face — 파생값 저장소 ───────────────────────────────
# 🔒 앱에 주는 토큰은 `sector-scores` **read 전용**.
#    쓰기가 필요한 `team-notes` 는 그 저장소 하나에만 권한이 있는
#    fine-grained 토큰을 따로 만든다. 폭발 반경을 격리한다.
# 🔴 HF 에는 섹터 집계·점수만 올린다. KRX 원천은 로컬 `data/` 에만 (ADR-SC-0006).
HUGGINGFACE_ACCESS_TOKEN=
# 쓰기 전용 — 로컬 배치에서만 쓴다. Streamlit Secrets 에 넣지 않는다.
HUGGINGFACE_WRITE_TOKEN=

# ── 공시·매크로 ──────────────────────────────────────────────────
# DART OpenAPI — 공시 제목·접수일·유형. 점수에 들어가지 않는다 (타임라인 맥락)
DART_API_KEY=
# ECOS 한국은행 — 기준금리·환율 (매크로 배경)
ECOS_API_KEY=
FINANCE_SUPERVISORY_API_KEY=
DATA_GO_KR_API_KEY=
KOSIS_API_KEY=

# ── 뉴스 ────────────────────────────────────────────────────────
# 🔴 네이버 검색 API 특약(2026-09-07 시행) — 저장·캐싱·가공·재정렬·AI 입력 금지.
#    조회 시점에 제목·출처·시각·원문 링크만 노출한다. 요약·감성점수 금지.
NAVER_API_CLIENT_ID=
NAVER_API_SECRET_KEY=

# ── v2.0 Django (동결) ───────────────────────────────────────────
# ⚠️ 아래 값은 **`backend/.env`** 에 넣어야 읽힌다. 여기 넣으면 무시된다.
#    회귀 확인용으로만 쓴다: docker compose --profile v2 up -d postgres
POSTGRES_DB=stockcoin
POSTGRES_USER=stockcoin
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
